{
  "name": "@opentax-it/fatturapa",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "FatturaPA (Italian e-invoice) XML builder for flat-rate regime invoices, validated against the official XSD.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "fast-xml-parser": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  }
}
