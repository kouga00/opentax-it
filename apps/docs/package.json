{
  "name": "@opentax-it/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site of OpenTax IT, built with Docusaurus from the Markdown files in docs/ and the OpenAPI document of the API.",
  "scripts": {
    "openapi": "pnpm --filter @opentax-it/api run openapi ../docs/openapi.json && node -e \"require('node:fs').mkdirSync('api', { recursive: true })\" && docusaurus clean-api-docs all --plugin-id openapi && docusaurus gen-api-docs all --plugin-id openapi",
    "start": "pnpm run openapi && docusaurus start --port 3002 --host 127.0.0.1",
    "build": "pnpm run openapi && docusaurus build",
    "serve": "docusaurus serve --port 3002 --host 127.0.0.1",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "2.0.1",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "@opentax-it/fiscal-rules": "workspace:*",
    "clsx": "2.1.1",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-plugin-sass": "0.2.7",
    "docusaurus-theme-openapi-docs": "5.2.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "1.105.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "7.0.2"
  }
}
