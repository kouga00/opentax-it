# Copia in .env e personalizza. Non committare mai .env.
# Password del database: scegline una (es. `openssl rand -hex 16`) e usala in entrambe le righe.
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://opentax:<POSTGRES_PASSWORD>@localhost:5432/opentax?schema=public"
API_PORT=3000
# Interfaccia di ascolto dell'API. Default 127.0.0.1: non esporla in rete finché manca l'autenticazione.
# API_HOST=127.0.0.1
# Host name accettati da API e web (protezione contro il DNS rebinding). Default: localhost,127.0.0.1,::1
# ALLOWED_HOSTS=
# Chiave di cifratura a riposo dei segreti dei tenant (password PEC): 32 byte in base64, es. `openssl rand -base64 32`.
# Senza non si può salvare la password PEC; se cambia, la password va inserita di nuovo in Impostazioni.
APP_ENCRYPTION_KEY=""
# URL dell'API usato dal server web (non esposto al browser).
API_URL=http://localhost:3000/api
# Directory dei file generati (XML fatture, ricevute SDI). Default: apps/api/storage
STORAGE_DIR=
# Optional: URL of the official AdE "Modello F24 Ordinario" PDF used to print F24 forms (downloaded once, cached in storage/models).
# F24_MODEL_URL=
# Optional: Banca d'Italia daily exchange rates endpoint (dailyRates, REST API v1.0), used to prefill exchange rates.
# EXCHANGE_RATES_URL=
# Solo se l'AdE pubblica una nuova edizione del modello: usa comunque un file con SHA-256 diverso da quello calibrato.
# F24_MODEL_ALLOW_UNVERIFIED=true
